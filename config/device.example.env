# Per-device — NEVER committed. `kc bootstrap` writes it in the core root; edit by hand to add
# the optional language override.

# Identifies this machine; the device overlay keys module paths off it.
KC_DEVICE_ID=my-laptop

# Optional language override for this device. Wins over instance.yml `language`; stays in
# effect until you remove it (nothing to commit).
# KC_LANGUAGE=ru
